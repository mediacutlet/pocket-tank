# pocket-tank — ESP32-S3R8, 8 MB octal PSRAM, 16 MB flash
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# PSRAM: octal, 80 MHz, available to malloc; memtest off to save boot time
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# RAM headroom move 1 (0.4.2, 2026-11-07): IDF's lwIP / net80211 / pp .bss in PSRAM (~12.5 KB internal back; the radio is cold); also lets EXT_RAM_BSS_ATTR place our own tables
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MEMTEST=n
# flash: octal-capable board; QIO fast; mmap'd model partition read through cache
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# radio: Wi-Fi only in update mode, at boot, before the tank exists
# (docs/OTA.md). No IRAM optimizations (they buy throughput with internal
# RAM), lwIP + the driver allowed in PSRAM, TLS on external memory, small
# buffer counts: a download is a trickle. No Bluetooth.
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
# over-the-air: two app slots (partitions.csv), a fresh image boots as
# "pending" until the tank has loaded its save (bootloader rollback), and
# only images signed with the project's key are accepted on update. The
# running image is the trust root (its own signature block carries the
# public key digest), so every cable build is signed with the SAME key:
# firmware/keys/ota_signing_key.pem, never committed (tools/ota_key.sh).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/ota_signing_key.pem"
# generous main stack for the tank/render task; inference has its own task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FREERTOS_HZ=1000
# THE WATCHDOG (0.4): the tank task is watched (main.c wdt_watch_tank_task, which also sets these at run time -
# a build directory keeps the sdkconfig it was made with): unfed 20 s panics and restarts (a pending image rolls back).
# The idle tasks are not watched: with panic on, a long boot step or update mode's flash work would restart the chip
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# real board: AMOLED + touch
CONFIG_POCKET_TANK_DISPLAY_SH8601=y
CONFIG_POCKET_TANK_TOUCH_FT3168=y
CONFIG_POCKET_TANK_AUDIO_ES8311=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# the tank switcher (docs/tank-switcher.md): the SD card library uses long names (/pocketank/tanks/...); off, FAT is 8.3 only
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# THE APP'S ROOM (0.4.2): the tank is only ever a Wi-Fi STATION and a TLS CLIENT (the update check + OTA from GitHub),
# so the parts it never runs are left out - ~120 KB of the app slot (docs/release-0.4.2.md, app space). The error-name
# table stays: the logs keepers send (pocketank.com/help's tank check) need the cause. firmware/CMakeLists.txt takes
# these keys out of an older sdkconfig so they apply there too.
# A real OTA install is the proof after any change here.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_LWIP_IPV6 is not set
