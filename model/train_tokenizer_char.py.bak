#!/usr/bin/env python3
"""Char-level tokenizer for the Aqua Pets advisor. Stdlib only.

The schema (schema.md, FROZEN) uses a closed lowercase-ASCII vocabulary, so instead
of sentencepiece we ship a fixed char-level vocab in llama2.c's tokenizer.bin format,
laid out so karpathy's run.c works unmodified:

  id 0          <unk>
  id 1          BOS  (rendered "\n<s>\n", llama2.c convention)
  id 2          EOS  (rendered "\n</s>\n")
  ids 3..258    byte-fallback tokens "<0x00>".."<0xFF>" (run.c assumes byte+3 here)
  ids 259..353  printable ASCII 0x20..0x7E as single-char tokens
  id 354        "\n"

vocab_size = 355. No multi-char tokens exist, so run.c's BPE merge loop is a no-op,
and its dummy-prefix lookup of " " resolves to a real token. Python-side encode()
mirrors run.c exactly (dummy space prefix, per-char lookup, byte fallback).

Training serialization (consumed by train.py, completed by the model at inference):

  <BOS> <state line> " -> " <goal line>      docs concatenated, BOS-separated

run.c stops generation on BOS, so a trained model emits the goal then halts.

Usage: python3 train_tokenizer.py [--out out/tokenizer.bin]
"""

import argparse
import os
import struct

BOS_ID, EOS_ID = 1, 2
SEP = " -> "  # between state and goal in a training doc

_PRINTABLE = [chr(c) for c in range(0x20, 0x7F)]


def build_vocab():
    vocab = ["<unk>", "\n<s>\n", "\n</s>\n"]
    vocab += [f"<0x{b:02X}>" for b in range(256)]
    vocab += _PRINTABLE
    vocab += ["\n"]
    return vocab


VOCAB = build_vocab()
VOCAB_SIZE = len(VOCAB)
_CHAR_TO_ID = {c: 259 + i for i, c in enumerate(_PRINTABLE)}
_CHAR_TO_ID["\n"] = VOCAB_SIZE - 1


def encode(text, bos=False):
    """Mirror run.c: optional BOS, dummy ' ' prefix, chars, byte fallback."""
    ids = [BOS_ID] if bos else []
    if text:
        ids.append(_CHAR_TO_ID[" "])
    for ch in text:
        if ch in _CHAR_TO_ID:
            ids.append(_CHAR_TO_ID[ch])
        else:
            ids.extend(3 + b for b in ch.encode("utf-8"))
    return ids


def encode_doc(state, goal):
    """One training document: BOS + 'state -> goal'."""
    return encode(state + SEP + goal, bos=True)


def decode(ids):
    out = []
    for i in ids:
        piece = VOCAB[i]
        if 3 <= i < 259:
            out.append(chr(int(piece[3:5], 16)))
        else:
            out.append(piece)
    return "".join(out)


def write_bin(path):
    with open(path, "wb") as f:
        f.write(struct.pack("<i", max(len(v.encode()) for v in VOCAB)))
        for v in VOCAB:
            b = v.encode("utf-8")
            f.write(struct.pack("<fi", 0.0, len(b)))
            f.write(b)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default=os.path.join(os.path.dirname(__file__), "out", "tokenizer.bin"))
    args = ap.parse_args()
    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    write_bin(args.out)
    sample = "fish mira zone 2 hunger 7 -> seek_food urgency 8"
    ids = encode(sample, bos=True)
    assert decode(ids[1:]).lstrip(" ").rstrip() == sample, "round-trip failed"
    print(f"wrote {args.out}: vocab_size={VOCAB_SIZE}, sample doc = {len(ids)} tokens")


if __name__ == "__main__":
    main()
